{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação do tabnews para o curso.dev",
  "homepage": "https://github.com/ComicShrimp/clone-tabnews#readme",
  "bugs": {
    "url": "https://github.com/ComicShrimp/clone-tabnews/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComicShrimp/clone-tabnews.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run wait-for-postgres && npm run migration:up && next dev",
    "services:up": "docker compose up -d",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:prettier:fix": "prettier --write .",
    "lint:prettier:check": "prettier --check .",
    "lint:eslint:check": "eslint",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k --success command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --watch --runInBand",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations up",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.js"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "next": "16.2.9",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.7.0",
    "@types/react": "19.2.17",
    "concurrently": "^10.0.3",
    "eslint": "^9.7.0",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.4"
  }
}
